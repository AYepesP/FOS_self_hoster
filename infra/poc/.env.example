# Secret used to derive per-user encryption keys via HMAC-SHA256.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this value across environments.
MASTER_SECRET=change-me-before-running

# Base directory where encrypted and plaintext volumes will be created.
# Must exist and be writable. Use an absolute path.
DATA_DIR=/tmp/almerno-poc
